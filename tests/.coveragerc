# Copied from tests/.coveragerc to .coveragerc on github actions

[run]
# Repository-relative paths, so the CI coverage job can combine every job
relative_files = True
omit =
    */__init__.py
    */_version.py
    # */behavior/*
    */cli/*
    # */common/*
    */data_import/*
    */decoding/v0/*
    # */decoding/*
    # */lfp/*
    # */linearization/*
    */lock/*
    */mua/*
    */position/* # gh-action differs from local run
    */ripple/*
    */sharing/*
    # */spikesorting/*
    # */utils/*
    settings.py

[paths]
# First entry: where the combining job finds the sources. run-tests installs
# spyglass into site-packages; the other jobs install it editable.
source =
    src/spyglass
    */site-packages/spyglass

[report]
exclude_lines =
    pragma: no cover
    if.*test_mode
    if __name__ == .__main__.:
    raise NotImplementedError
    pass
